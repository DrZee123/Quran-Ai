{
  "expo": {
    "name": "Hifz Saathi",
    "slug": "hifz-saathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hifzsaathi.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Tilawat sunne ke liye microphone chahiye. Awaz phone se bahar nahi jati."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F5132",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hifzsaathi.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "scheme": "hifzsaathi",
    "experiments": {
      "typedRoutes": false
    }
  }
}
